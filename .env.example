# Copy this file to ".env" and fill in the key(s) for the provider(s) you intend to use.
# Never commit the real ".env" file. Keys are read only from environment variables.

# Required when config provider.name = "anthropic"
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required when config provider.name = "openai"
OPENAI_API_KEY=your-openai-api-key-here

# No key needed when config provider.name = "mock"
